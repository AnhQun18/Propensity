  "models": [
    {
      "exp_id": "L0_base_rate",
      "role": "Sàn ngẫu nhiên theo từng tháng",
      "question": "Ngẫu nhiên chọn K=1% (~1.003 khách/tháng) đạt mức nào?",
      "family": "prevalence",
      "feature_set": "none",
      "uses_target_lag": false,
      "is_probabilistic": true,
      "stochastic_across_seeds": false,
      "is_reference_only": false
    },
    {
      "exp_id": "L2_rule_trx_rfm",
      "role": "Luật RFM thuần TRX (không nhãn)",
      "question": "Luật đơn giản có đủ chưa, và snapshot có sạch không?",
      "family": "rule_trx_rfm",
      "feature_set": "rule_trx_rfm_6",
